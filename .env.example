# Layer 3 (Smart Recommendations) is provider-agnostic.
# Set EITHER key to enable live LLM generation. With neither key set, the app
# falls back to a deterministic rule-based generator so the demo always runs.

# Option A - Anthropic
ANTHROPIC_API_KEY=
TENANTEASE_LLM_MODEL=claude-haiku-5-5

# Option B - OpenAI
OPENAI_API_KEY=
# TENANTEASE_LLM_MODEL=gpt-4o-mini

# Force a specific provider: anthropic | openai | fallback (default: auto)
TENANTEASE_LLM_PROVIDER=auto
